# Copy to .env.local for development. In production set these in your host's dashboard.

# Supabase project (Project Settings -> API). The publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy alternative accepted by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public site URL, used in invitation links and emails.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.ke

# Server-only. Used ONLY by the delivery worker (/api/jobs/deliver). Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shared secret your scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string

# Outbound email for invitations and admin alerts (optional; tasks stay queued without it).
RESEND_API_KEY=
EMAIL_FROM="nyumbani <no-reply@your-domain.co.ke>"

# Server-only. Google Places API (New) for location suggestions in search and the listing wizard.
# Optional: without it, location fields are plain text. Restrict the key to the Places API (New).
GOOGLE_MAPS_API_KEY=

# Phone one-time codes need an SMS provider configured in Supabase Auth first.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
