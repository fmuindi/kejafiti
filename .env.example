# Copy to .env.local for development. In production set these in your host's dashboard.

# Supabase project (Project Settings -> API). The publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy alternative accepted by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public site URL, used in invitation links and emails.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.ke

# Server-only. Used ONLY by the delivery worker (/api/jobs/deliver). Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shared secret your scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string

# Local development: send all outbound email to the Mailpit inbox (http://127.0.0.1:54324),
# never to real people. Leave empty in production.
MAILPIT_URL=http://127.0.0.1:54324

# Outbound email for invitations and admin alerts (optional; tasks stay queued without it).
# Used when MAILPIT_URL is empty. EMAIL_FROM must be on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM="nyumbani <no-reply@your-domain.co.ke>"

# Server-only. Google Places API (New) for location suggestions in search and the listing wizard.
# Optional: without it, location fields are plain text. Restrict the key to the Places API (New).
GOOGLE_MAPS_API_KEY=

# Optional, browser-visible. Maps Embed API key (free tier) for the "approximate area" map on
# listings. Restrict it to your domains and to the Maps Embed API only. Empty = no map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Phone one-time codes need an SMS provider configured in Supabase Auth first.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# AI search (natural-language + voice). Server-only; never prefix with NEXT_PUBLIC_.
# Without a key, the describe-your-home box and microphone are hidden; filters still work.
OPENAI_API_KEY=
# Backup for typed requests when OpenAI is down or out of credit (Claude has no speech-to-text,
# so voice needs OpenAI). Order: OpenAI -> Anthropic -> ordinary filters.
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-opus-5-5
# Provider order for typed requests (comma-separated). Empty = openai,anthropic.
AI_INTENT_PROVIDERS=
# Optional overrides (defaults shown). Choose by running: node scripts/ai-eval.mjs
OPENAI_INTENT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Switches and daily caps (all visitors / per visitor). Search falls back to filters at a cap.
AI_SEARCH_ENABLED=true
AI_VOICE_ENABLED=true
AI_DAILY_SEARCH_CAP=2000
AI_DAILY_VOICE_CAP=300
AI_CLIENT_DAILY_SEARCH_CAP=60
AI_CLIENT_DAILY_VOICE_CAP=20
# Assistance features (listing drafts, report commentary, help answers). All on when a key is set;
# set AI_ASSIST_ENABLED=false to turn all off, or e.g. AI_HELP_ANSWER_ENABLED=false for one.
AI_ASSIST_ENABLED=true
AI_DAILY_ASSIST_CAP=500
AI_DAILY_HELP_CAP=1000
